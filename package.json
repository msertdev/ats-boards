{
  "name": "ats-boards",
  "version": "0.3.0",
  "description": "Discover and read public job boards of applicant-tracking systems used by German employers: Personio, SmartRecruiters, Greenhouse, Lever, Ashby, Recruitee, Teamtailor, JOIN, Workable, Workday, Oracle Recruiting, softgarden.",
  "license": "MIT",
  "author": "Murat Sert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msertdev/ats-boards.git"
  },
  "homepage": "https://github.com/msertdev/ats-boards",
  "keywords": [
    "ats",
    "jobs",
    "job-board",
    "germany",
    "personio",
    "greenhouse",
    "smartrecruiters",
    "workday",
    "lever",
    "ashby",
    "recruitee",
    "softgarden",
    "scraper-free"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  },
  "bin": {
    "ats-boards": "dist/cli.js"
  }
}
