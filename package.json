  "license": "MIT",
  "author": "Murat Sert",
  "repository": { "type": "git", "url": "https://github.com/msertdev/ats-boards.git" },
  "homepage": "https://github.com/msertdev/ats-boards",
  "keywords": ["ats", "jobs", "job-board", "germany", "personio", "greenhouse", "smartrecruiters", "workday", "lever", "ashby", "recruitee", "softgarden", "scraper-free"],
  "type": "module",
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
